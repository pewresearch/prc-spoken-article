{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "prc-spoken-article/player-trigger",
	"version": "0.1.0",
	"title": "Spoken Article Trigger",
	"category": "media",
	"description": "Inline trigger button that opens the spoken article player when audio is available",
	"usesContext": ["postId"],
	"supports": {
		"anchor": true,
		"html": false,
		"multiple": false,
		"reusable": false,
		"spacing": {
			"margin": ["top", "bottom"],
			"padding": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		}
	},
	"textdomain": "prc-spoken-article",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
