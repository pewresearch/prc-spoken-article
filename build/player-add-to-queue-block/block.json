{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "prc-spoken-article/player-add-to-queue",
  "version": "1.0.0",
  "title": "Add to Queue",
  "category": "widgets",
  "description": "Add-to-queue button for spoken articles. Place inside a content-gate block with allowPassThrough enabled.",
  "usesContext": [
    "postId"
  ],
  "attributes": {},
  "supports": {
    "anchor": true,
    "html": false,
    "interactivity": true,
    "color": {
      "background": true,
      "text": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    },
    "spacing": {
      "padding": true,
      "__experimentalDefaultControls": {
        "padding": true
      }
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "style": true,
        "width": true
      }
    }
  },
  "textdomain": "prc-spoken-article",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}